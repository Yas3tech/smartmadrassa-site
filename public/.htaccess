# ==========================================================================
#  SmartMadrassa — site vitrine (hébergement mutualisé OVH, Apache)
#  Placer ce fichier à la racine du dossier www/ avec le contenu de dist/
# ==========================================================================

# --- Forcer PHP 8.2 (spécifique OVH, ignoré ailleurs) ---------------------
# Si le formulaire de contact renvoie une erreur 500, commentez la ligne
# suivante ou ajustez-la à une version disponible dans votre hébergement.
# AddHandler application/x-httpd-php82 .php

# --- Page d'erreur --------------------------------------------------------
# 404.html porte <meta name="robots" content="noindex"> et est servie avec un
# vrai code 404. Renvoyer index.html en 200 pour une adresse inexistante — ce
# qu'on appelle une « soft 404 » — pousse Google à indexer des pages d'erreur.
ErrorDocument 404 /404.html
# Page affichée pendant le mode construction (voir plus bas).
ErrorDocument 503 /construction.html

Options -Indexes -MultiViews
DirectoryIndex index.html
# Les pages vivent dans des dossiers (fr/tarifs/index.html) mais leur adresse
# n'a pas de barre finale : c'est celle des canoniques, du sitemap et des liens.
# Sans cette ligne, Apache ajoute la barre par une redirection qui contredit la
# canonique (et y colle un « :443 »).
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP -> HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www -> apex (inversez si vous préférez www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # --- Mode construction ------------------------------------------------
  # Actif tant que construction.html existe : les visiteurs voient cette page
  # avec un code 503, que Google comprend comme une indisponibilité passagère.
  # Pour voir le vrai site, ouvrir une fois par appareil :
  #   https://smartmadrassa.be/?apercu=8a7bb2f69e036b0b10f25c36
  # Un cookie d'un an ouvre ensuite l'accès. Pour ouvrir le site au public,
  # supprimer public/construction.html et republier.
  RewriteCond %{QUERY_STRING} (?:^|&)apercu=8a7bb2f69e036b0b10f25c36(?:&|$)
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1? [CO=sm_apercu:8a7bb2f69e036b0b10f25c36:smartmadrassa.be:525600:/:1:1,R=302,L]

  RewriteCond %{DOCUMENT_ROOT}/construction.html -f
  RewriteCond %{HTTP_COOKIE} !(?:^|;\s*)sm_apercu=8a7bb2f69e036b0b10f25c36(?:;|$)
  RewriteCond %{REQUEST_URI} !^/(construction\.html|favicon\.ico|icon-192\.png|robots\.txt)$
  RewriteRule ^ - [R=503,L]

  # --- Rétrocompatibilité et redirection vers /fr/, /nl/, /ar/ ----------
  # 1. Requêtes avec paramètre ?lang= (anciennes URL)
  RewriteCond %{QUERY_STRING} (?:^|&)lang=(fr|nl|ar)(?:&|$) [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/%1/$1? [R=301,L]

  # 2. Anciennes URLs sans préfixe redirigées vers la version française
  RewriteRule ^(mentions-legales|confidentialite|conditions-utilisation)/?$ https://%{HTTP_HOST}/fr/$1 [R=301,L]
  RewriteRule ^(tarifs|fonctionnalites|solutions|comparatif|securite-rgpd|guides|contact)(/[^/].*?)?/?$ https://%{HTTP_HOST}/fr/$1$2 [R=301,L]

  # 3. Une seule adresse par page : /fr/ avec barre, les sous-pages sans.
  RewriteRule ^(fr|nl|ar)$ https://%{HTTP_HOST}/$1/ [R=301,L]
  RewriteRule ^(fr|nl|ar)/(.+)/$ https://%{HTTP_HOST}/$1/$2 [R=301,L]

  # --- Servir les pages pré-rendues multilingues ------------------------
  # Racine d'une langue (/fr/, /nl/, /ar/)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(fr|nl|ar)/?$ /$1/index.html [L]

  # Sous-pages pré-rendues (/fr/fonctionnalites/presences, etc.)
  RewriteCond %{DOCUMENT_ROOT}/$1/$2/index.html -f
  RewriteRule ^(fr|nl|ar)/(.+?)/?$ /$1/$2/index.html [L]

  # Repli monopage si la ressource n'existe pas comme fichier réel
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(fr|nl|ar)/.*$ /$1/index.html [L]
</IfModule>

# --- En-têtes de sécurité -------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # DENY plutôt que SAMEORIGIN : aucune page du site ne s'intègre elle-même
  # dans un cadre, autant fermer complètement la porte au clickjacking.
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Tout est servi depuis l'origine, à une exception près : Google Analytics,
  # et seulement si le visiteur l'a accepté — le script n'est pas chargé avant.
  # Les trois domaines ouverts sont le strict nécessaire de GA4 : le script
  # (googletagmanager), la collecte (google-analytics) et son point d'entrée
  # régional européen.
  # style-src autorise l'inline parce que Tailwind et Framer Motion posent des
  # styles sur l'élément ; script-src n'accepte toujours aucun script en ligne.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com; font-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"

  # Le contenu est négocié selon l'encodage : sans Vary, un cache partagé peut
  # servir une réponse compressée à un client qui ne la comprend pas.
  Header append Vary "Accept-Encoding"

  # Les fichiers versionnés par Vite (hash dans le nom) sont immuables
  <FilesMatch "\.(js|css|woff2|woff|svg|png|jpg|jpeg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Le HTML ne doit jamais être mis en cache durablement
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Ce script est chargé avant le rendu et son nom n'est pas versionné.
  <Files "theme-init.js">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </Files>

  # Le point d'entrée du formulaire n'a rien à faire dans un index.
  <FilesMatch "\.php$">
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# --- Compression ----------------------------------------------------------
# Brotli d'abord quand le module est disponible : environ 15 % de mieux que
# gzip sur du texte. mod_deflate prend le relais sinon.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

# --- Expiration (repli si mod_headers absent) -----------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Types MIME -----------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Protection des fichiers sensibles ------------------------------------
<FilesMatch "^(\.env|\.htaccess|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json|pnpm-lock\.yaml|.*\.map|.*\.ts|.*\.tsx)$">
  Require all denied
</FilesMatch>
